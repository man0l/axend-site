---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="acc">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>
<style>
  .acc { border-top: 1px solid var(--hair); }
  details { border-bottom: 1px solid var(--hair); }
  summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 0; cursor: pointer; list-style: none; color: var(--text); font-weight: 600; font-size: 1.0625rem; }
  summary::-webkit-details-marker { display: none; }
  i { position: relative; width: 20px; height: 20px; flex: none; }
  i::before, i::after { content: ''; position: absolute; left: 3px; right: 3px; top: 9px; height: 2px; border-radius: 2px; background: var(--eyebrow); transition: transform .2s; }
  i::after { transform: rotate(90deg); }
  details[open] i::after { transform: rotate(0); }
  details p { margin: 0 0 20px; max-width: 46em; }
  @media (prefers-reduced-motion: reduce) { i::before, i::after { transition: none; } }
</style>
