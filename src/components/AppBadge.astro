---
// Official store badges (Apple and Google artwork, unmodified). Google Play links once SITE.playStoreUrl is set;
// until then it shows as "coming soon" rather than pointing at a listing that does not exist.
import { SITE, appStoreLink, playStoreLink } from '../lib/site';
interface Props { ct: string; center?: boolean }
const { ct, center = false } = Astro.props;
---
<div class:list={['stores', { center }]}>
  <a class="store" href={appStoreLink(ct)} rel="noopener">
    <img src="/badges/app-store.svg" alt="Download on the App Store" width="144" height="48" />
  </a>
  {SITE.playStoreUrl
    ? <a class="store" href={playStoreLink(ct)} rel="noopener"><img src="/badges/google-play.png" alt="Get it on Google Play" width="161" height="48" /></a>
    : <span class="store soon"><img src="/badges/google-play.png" alt="Google Play, coming soon" width="161" height="48" /><em>Soon</em></span>}
</div>
<style>
  .stores { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .stores.center { justify-content: center; }
  .store { position: relative; display: inline-flex; border-radius: 8px; transition: transform .15s, filter .15s; }
  .store img { display: block; height: 48px; width: auto; }
  a.store:hover { transform: translateY(-1px); filter: brightness(1.15); }
  .soon { cursor: default; }
  .soon img { opacity: .45; }
  .soon em { position: absolute; top: -9px; right: -8px; padding: 2px 8px; border-radius: 999px; background: var(--pill); color: var(--ink); font-style: normal; font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
</style>
