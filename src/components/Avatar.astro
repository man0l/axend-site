---
import { initials } from '../data/authors';
interface Props { name: string; photo?: string; size?: number }
const { name, photo, size = 44 } = Astro.props;
---
{photo
  ? <img class="av" src={photo} alt={name} width={size} height={size} loading="lazy" style={`width:${size}px;height:${size}px`} />
  : <span class="av ini" role="img" aria-label={name} style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.38)}px`}>{initials(name)}</span>}
<style>
  .av { border-radius: 50%; object-fit: cover; flex: none; border: 1px solid var(--hair); }
  .ini { display: inline-flex; align-items: center; justify-content: center; background: #1a130d; color: #f3e6d6; font-weight: 700; letter-spacing: .02em; }
</style>
