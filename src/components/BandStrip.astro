---
const bands = [['1–3', 'Low'], ['3–5.5', 'Below mid'], ['5.5–7.5', 'Balanced'], ['7.5–9', 'Strong'], ['9–10', 'Rare']];
---
<div class="strip" role="img" aria-label="Score bands from 1 to 10">
  {bands.map(([r, n], i) => <div class={`b b${i}`}><span class="num r">{r}</span><span class="nm">{n}</span></div>)}
</div>
<style>
  .strip { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }
  .b { padding: 20px 6px 18px; text-align: center; border-radius: 10px; background: var(--card); border: 1px solid var(--hair-soft); border-top: 3px solid color-mix(in srgb, var(--eyebrow) calc(var(--k) * 1%), #3a2a1c); display: grid; gap: 4px; }
  .b0 { --k: 15; } .b1 { --k: 35; } .b2 { --k: 60; } .b3 { --k: 85; } .b4 { --k: 100; }
  .b2 { background: #3a2a1c; border-color: var(--eyebrow); }
  .r { color: #fff; font-size: 1.05rem; white-space: nowrap; }
  .nm { white-space: nowrap; font-size: .72rem; color: var(--lead); font-weight: 600; letter-spacing: .02em; }
  @media (max-width: 420px) { .b { padding: 12px 2px 10px; } .r { font-size: .9rem; } .nm { font-size: .66rem; letter-spacing: 0; } }
  @media (min-width: 560px) { .r { font-size: 1.4rem; } .nm { font-size: .85rem; } }
</style>
