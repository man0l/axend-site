---
import { TOOLS } from '../data/tools';
import { CLUSTERS } from '../lib/site';
import AppBadge from './AppBadge.astro';
const clusters = Object.values(CLUSTERS);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div class="brand">
        <a href="/" class="wordmark">axend<span>.</span></a>
        <p class="disclaimer">For adults 18+. Scores are cosmetic and approximate. Not medical advice and not a judgment of worth. Face landmark detection by Google MediaPipe; the scores are Axend's own.</p>
        <AppBadge ct="footer" />
      </div>
      <div><h3>Tests</h3>{TOOLS.map((t) => <a href={t.path}>{t.nav}</a>)}</div>
      <div><h3>Guides</h3>{clusters.map((c) => <a href={`/guides/${c.slug}`}>{c.label}</a>)}<a href="/guides">All guides</a></div>
      <div><h3>Axend</h3><a href="/app">The app</a><a href="/about">About</a><a href="/how-we-score">How we score</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/contact">Contact</a></div>
    </div>
  </div>
</footer>
<style>
  .site-footer { position: relative; z-index: 1; border-top: 1px solid var(--hair-soft); padding: 72px 0 56px; background: linear-gradient(180deg, transparent, rgba(0,0,0,.35)); }
  .cols { display: grid; gap: 40px; grid-template-columns: 1.5fr 1fr 1fr 1fr; }
  .cols > div { display: flex; flex-direction: column; gap: 10px; }
  .cols a:not(.badge) { color: var(--body); text-decoration: none; font-size: .95rem; }
  .cols a:not(.badge):hover { color: #fff; }
  .cols h3 { font-size: .78rem; text-transform: uppercase; letter-spacing: .14em; color: var(--eyebrow); margin: 0 0 6px; font-weight: 700; }
  .wordmark { font-size: 1.55rem; font-weight: 800; color: #fff !important; letter-spacing: -0.03em; }
  .wordmark span { color: var(--accent); }
  .brand { align-items: flex-start; }
  .brand .disclaimer { margin: 4px 0 12px; max-width: 32em; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
</style>
