---
import { clusterOf, type Post } from '../lib/posts';
interface Props { post: Post; featured?: boolean }
const { post, featured = false } = Astro.props;
const words = (post.body ?? '').split(/\s+/).length;
const mins = Math.max(3, Math.round(words / 200));
---
<a class:list={['gc', { featured }]} href={`/guides/${post.data.slug}`}>
  <span class="top"><span class="cl">{clusterOf(post).label}</span><span class="rt">{mins} min read</span></span>
  <strong>{post.data.title}</strong>
  <span class="d">{post.data.description}</span>
  <span class="go">Read guide <i aria-hidden="true">→</i></span>
</a>
<style>
  .gc { display: flex; flex-direction: column; gap: 10px; padding: 24px 0 28px; border-top: 1px solid var(--hair); text-decoration: none; color: var(--body); transition: border-color .2s; height: 100%; }
  .gc:hover { border-top-color: var(--eyebrow); }
  .top { display: flex; justify-content: space-between; gap: 12px; font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .cl { color: var(--eyebrow); } .rt { color: var(--muted); letter-spacing: .04em; text-transform: none; font-weight: 600; font-size: .8rem; }
  strong { color: #fff; font-size: 1.3rem; line-height: 1.22; letter-spacing: -0.02em; }
  .d { font-size: .97rem; flex: 1; }
  .go { color: var(--pill); font-weight: 700; font-size: .9rem; } .go i { font-style: normal; display: inline-block; transition: transform .2s; } .gc:hover .go i { transform: translateX(4px); }
  .featured { padding: 28px; border: 1px solid var(--hair); border-radius: var(--radius); background: var(--card-bg); box-shadow: inset 0 1px 0 var(--hi); }
  .featured strong { font-size: clamp(1.7rem, 4vw, 2.4rem); line-height: 1.1; letter-spacing: -0.03em; }
  .featured .d { font-size: 1.1rem; color: var(--lead); }
  @media (prefers-reduced-motion: reduce) { .go i { transition: none; } }
</style>
