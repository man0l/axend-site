---
import { TOOLS } from '../data/tools';
import { appStoreLink } from '../lib/site';
---
<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="wordmark" aria-label="axend home">axend<span>.</span></a>
    <nav aria-label="Main">
      <details class="menu" id="tests-menu">
        <summary>Tests</summary>
        <div class="drop">
          {TOOLS.map((t) => <a href={t.path}><strong>{t.nav}</strong><span>{t.blurb}</span></a>)}
        </div>
      </details>
      <a class="lnk" href="/guides">Guides</a>
      <a class="lnk" href="/app">The App</a>
      <a class="btn ghost small" href={appStoreLink('header')} rel="noopener">Get Axend</a>
    </nav>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(15, 12, 8, .72); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-bottom: 1px solid var(--hair-soft); transition: border-color .2s, background .2s; }
  .site-header.stuck { border-bottom-color: var(--hair); background: rgba(15, 12, 8, .86); }
  .bar { display: flex; justify-content: space-between; align-items: center; min-height: 60px; gap: 10px; }
  .wordmark { font-size: 1.55rem; font-weight: 800; color: #fff; text-decoration: none; letter-spacing: -0.03em; }
  .wordmark span { color: var(--accent); }
  nav { display: flex; align-items: center; gap: 6px; }
  .lnk, summary { color: var(--body); text-decoration: none; font-weight: 600; padding: 8px 10px; border-radius: 8px; cursor: pointer; font-size: .95rem; }
  .lnk:hover, summary:hover { color: #fff; }
  .menu { position: relative; }
  summary { list-style: none; display: block; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ''; display: inline-block; width: 6px; height: 6px; margin: 0 0 3px 7px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); }
  .drop { position: absolute; z-index: 60; top: calc(100% + 10px); left: -10px; width: 300px; background: #1b140e; border: 1px solid var(--hair); border-radius: 16px; padding: 8px; display: flex; flex-direction: column; box-shadow: 0 24px 48px -12px rgba(0,0,0,.7), inset 0 1px 0 var(--hi); }
  .drop a { padding: 10px 12px; text-decoration: none; border-radius: 10px; display: grid; gap: 1px; }
  .drop a:hover { background: var(--card); }
  .drop strong { color: #fff; font-size: .95rem; }
  .drop span { color: var(--muted); font-size: .82rem; line-height: 1.35; }
  @media (max-width: 560px) {
    .lnk[href='/app'] { display: none; }
    .btn.small { padding: 6px 14px; }
    .drop { position: fixed; left: 12px; right: 12px; top: 64px; width: auto; }
  }
</style>
<script>
  const h = document.querySelector('.site-header')!, m = document.getElementById('tests-menu') as HTMLDetailsElement;
  const on = () => h.classList.toggle('stuck', scrollY > 8); on(); addEventListener('scroll', on, { passive: true });
  document.addEventListener('click', (e) => { if (m.open && !m.contains(e.target as Node)) m.open = false; });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') m.open = false; });
</script>
