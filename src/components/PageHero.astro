---
import AnnotatedFace from './AnnotatedFace.astro';
import Portrait from './Portrait.astro';
import type { FaceId } from '../data/faces';
// Leave portrait unset on privacy and legal pages: faces stay off those.
interface Props { eyebrow: string; title: string; lead?: string; meta?: string; mesh?: boolean; portrait?: FaceId; portraitMode?: 'guides' | 'plain' }
const { eyebrow, title, lead, meta, mesh = true, portrait, portraitMode = 'plain' } = Astro.props;
---
<section class="ph">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap ph-in">
    <div class="tx">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      {meta && <p class="meta">{meta}</p>}
      <slot />
    </div>
    {portrait
      ? <div class="vis" aria-hidden="true"><div class="plate photo"><Portrait face={portrait} mode={portraitMode} /></div></div>
      : mesh && <div class="vis" aria-hidden="true"><div class="plate"><AnnotatedFace /></div></div>}
  </div>
</section>
<style>
  .ph { position: relative; padding: 40px 0 24px; }
  .glow { position: absolute; inset: -100px 0 auto; height: 520px; background: radial-gradient(40% 60% at 78% 40%, #3a2214, transparent); pointer-events: none; }
  .ph-in { position: relative; display: grid; gap: 24px; grid-template-columns: minmax(0, 1fr); align-items: center; }
  h1 { font-size: clamp(2.4rem, 7vw, 3.5rem); }
  .vis { display: none; }
  .plate { background: #0c0906; border: 1px solid var(--hair); border-radius: var(--radius); padding: 14px; width: 220px; margin-left: auto; box-shadow: inset 0 1px 0 var(--hi); }
  .plate.photo { padding: 0; width: 260px; overflow: hidden; }
  @media (min-width: 800px) { .ph { padding: 64px 0 32px; } .ph-in { grid-template-columns: minmax(0, 1fr) 260px; gap: 56px; } .vis { display: block; } }
</style>
