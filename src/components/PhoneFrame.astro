---
// Cropped App Store screenshot (already contains the device bezel), shown rising from the bottom edge.
interface Props { src: string; alt: string; width?: number; eager?: boolean }
const { src, alt, width = 260, eager = false } = Astro.props;
---
<figure class="phone" style={`--w:${width}px`}>
  <img src={src} alt={alt} width="550" height="1056" loading={eager ? 'eager' : 'lazy'} decoding="async" />
</figure>
<style>
  .phone { margin: 0; width: var(--w); max-width: 100%; position: relative; filter: drop-shadow(0 30px 40px rgba(0,0,0,.55)); }
  .phone img { display: block; width: 100%; height: auto; -webkit-mask-image: linear-gradient(180deg, #000 78%, transparent 100%); mask-image: linear-gradient(180deg, #000 78%, transparent 100%); }
</style>
