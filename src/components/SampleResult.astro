---
import ScoreRing from './ScoreRing.astro';
import TraitRow from './TraitRow.astro';
import LockedRows from './LockedRows.astro';
import Portrait from './Portrait.astro';
import { SAMPLES } from '../data/samples';
import type { Focus } from '../data/tools';
import type { FaceId } from '../data/faces';
interface Props { focus: Focus; ct: string; cta?: boolean }
const { focus, ct, cta = false } = Astro.props;
const s = SAMPLES[focus];
// symmetry must stay f3: Portrait's mirrored pairs are measured on that image.
const FACE: Record<Focus, FaceId> = { overall: 'f2', symmetry: 'f3', face: 'f1', men: 'm1', rating: 'm3' };
const pick = (n: string) => s.traits.find((t) => t.name === n)?.score ?? 0;
---
<div class="sample" aria-hidden={cta ? undefined : 'true'}>
  <div class="mesh"><Portrait face={FACE[focus]} mode="full" alt="AI-generated example portrait with a measurement overlay" score={s.score} readouts={[['SYM', pick('Symmetry')], ['JAW', pick('Jawline')]]} mirror={s.mesh === 'symmetry'} /></div>
  <div class="out">
    <div class="rr"><ScoreRing score={s.score} size={112} label={s.ringLabel} /><div><p class="cap">{s.caption}</p><span class="tag balanced">Balanced band</span></div></div>
    <ul class="traits">{s.traits.map((t) => <TraitRow {...t} />)}</ul>
    <LockedRows ct={ct} rows={s.locked} cta={cta} />
  </div>
</div>
<style>
  .sample { display: grid; gap: 18px; grid-template-columns: 1fr; }
  .mesh { position: relative; border-radius: 14px; background: #0c0906; border: 1px solid var(--hair-soft); overflow: hidden; max-width: 300px; margin: 0 auto; width: 100%; }
  .out { display: grid; gap: 12px; min-width: 0; }
  .rr { display: flex; align-items: center; gap: 16px; }
  .cap { margin: 0 0 6px; color: var(--lead); font-weight: 600; font-size: .95rem; text-wrap: balance; }
  .traits { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  @media (min-width: 640px) {
    .sample { grid-template-columns: 280px 1fr; align-items: start; column-gap: 18px; }
    .out { display: contents; }
    .mesh { margin: 0; grid-column: 1; grid-row: 1 / span 2; }
    .rr { grid-column: 2; grid-row: 1; }
    .traits { grid-column: 2; grid-row: 2; }
    .out > :global(.locked) { grid-column: 1 / -1; grid-row: 3; }
    .sample { row-gap: 12px; }
  }
</style>
