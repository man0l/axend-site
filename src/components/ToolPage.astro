---
import Base from '../layouts/Base.astro';
import Scanner from './Scanner.astro';
import PostCard from './PostCard.astro';
import { TOOLS, type Tool } from '../data/tools';
import { getPosts } from '../lib/posts';
import { SITE } from '../lib/site';
interface Props { tool: Tool }
const { tool } = Astro.props;
const others = TOOLS.filter((t) => t.path !== tool.path);
const posts = (await getPosts()).filter((p) => p.data.tool === tool.path).slice(0, 6);
const related = posts.length >= 3 ? posts : (await getPosts()).slice(0, 4);
const url = new URL(tool.path, SITE.url).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: tool.nav, url, applicationCategory: 'LifestyleApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, description: tool.description },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: tool.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={tool.title} description={tool.description} path={tool.path} jsonLd={jsonLd}>
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">{tool.eyebrow}</p>
      <h1>{tool.h1[0]}<br />{tool.h1[1]}</h1>
      <p class="lead">{tool.intro}</p>
      <span class="pill">{tool.pill}</span>
    </section>
    <Scanner ct={tool.ct} focus={tool.focus} />
    <section class="section prose">
      {tool.body.map((b) => <><h2>{b.h}</h2><p>{b.p}</p></>)}
      <p>Read the full method on <a href="/how-we-score">How we score</a>.</p>
    </section>
    <section class="section faq prose">
      <h2>Frequently asked questions</h2>
      {tool.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>
    <section class="section">
      <h2>Related guides</h2>
      <div class="grid">{related.map((p) => <PostCard post={p} />)}</div>
    </section>
    <section class="section">
      <h2>Try another test</h2>
      <div class="chips">{others.map((t) => <a class="chip" href={t.path}>{t.nav}</a>)}</div>
    </section>
  </div>
</Base>
