---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import StepCard from '../components/StepCard.astro';
import Accordion from '../components/Accordion.astro';
import AppBadge from '../components/AppBadge.astro';
const modules = [
  ['skin', 'Skin', 'A simple routine built around your skin, not a shelf of products.', 'wide'],
  ['hair', 'Hair', 'Cuts and styling that suit your face shape and hair type.', 'wide'],
  ['jaw', 'Jawline', 'Realistic guidance on the things that change how your jaw reads.', ''],
  ['posture', 'Posture', 'Short daily exercises for head and shoulder position.', ''],
  ['smile', 'Smile', 'Care and presentation habits for a confident smile.', ''],
];
const week = [['01', 'Scan', 'Two guided photos give you a baseline across the areas you choose.', 'scan'], ['02', 'Plan', 'Axend builds step-by-step routines and tutorials from your scan.', 'plan'], ['03', 'Daily session', 'A short session each day, with streaks and check-ins to keep you going.', 'streak'], ['04', '14-day snapshot', 'Every 14 days a new snapshot shows what actually moved.', 'snap']];
const faq = [
  { q: 'How much does Axend cost?', a: 'Axend is free to download. A subscription is $4.99 per week or $49.99 per year, billed through the App Store. Prices and the current offer are shown on the App Store listing.' },
  { q: 'Is it only for men?', a: 'No. The modules (skin, hair, jawline, posture and smile) apply to anyone 18 or over. Some copy on the web tests is written for men because that is who searches for them.' },
  { q: 'Are the scores medical advice?', a: 'No. Scores are cosmetic and approximate. They are not medical advice and not a judgment of your worth. See a doctor or dermatologist for medical concerns.' },
  { q: 'Is the web scan the same as the app?', a: 'The web scan is a free baseline that runs entirely on your device. The app has the full trait breakdown, your plan and progress tracking.' },
];
const jsonLd = [{ '@context': 'https://schema.org', '@type': 'MobileApplication', name: 'Axend', operatingSystem: 'iOS', applicationCategory: 'LifestyleApplication', url: 'https://axendai.com/app', offers: [{ '@type': 'Offer', price: '4.99', priceCurrency: 'USD', description: 'Weekly' }, { '@type': 'Offer', price: '49.99', priceCurrency: 'USD', description: 'Yearly' }] }];
---
<Base title="Axend App: Your Grooming and Self-Care Plan | Axend" description="Axend turns your face scan into a plan across skin, hair, jawline, posture and smile. Private by design. iOS." path="/app" jsonLd={jsonLd}>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap hg">
      <div class="tx">
        <p class="eyebrow">The Axend app</p>
        <h1>Do the work. <span>Track the change.</span></h1>
        <p class="lead">Axend turns a baseline scan into a plan across five modules, then tracks your progress every 14 days. Scores are cosmetic and approximate, for adults 18+.</p>
        <div class="acts"><AppBadge ct="app-page" primary /><a class="btn ghost" href="/">Take the free test first</a></div>
        <p class="price"><strong class="num">$4.99</strong>/week or <strong class="num">$49.99</strong>/year · Free to download · 18+</p>
      </div>
      <div class="ph"><PhoneFrame src="/app/hero.webp" alt="Axend app overall score card" width={300} eager /></div>
    </div>
  </section>

  <section class="sec"><div class="wrap">
    <div class="sec-head"><p class="eyebrow">Five modules</p><h2>One plan, five places to work.</h2></div>
    <div class="bento">{modules.map(([i, n, d, w]) => <div class={`card cell ${w}`}><span class="ic"><Icon name={i} size={22} /></span><h3>{n}</h3><p>{d}</p></div>)}</div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="sec-head"><p class="eyebrow">A week in Axend</p><h2>From scan to proof.</h2></div>
    <ol class="steps">{week.map(([n, t, d, i]) => <StepCard n={n} title={t} text={d} icon={i} />)}</ol>
    <div class="shots"><PhoneFrame src="/app/traits.webp" alt="Axend trait scores" width={230} /><PhoneFrame src="/app/plan.webp" alt="Axend daily jawline workout" width={230} /><PhoneFrame src="/app/streak.webp" alt="Axend streak calendar" width={230} /></div>
  </div></section>

  <section class="sec"><div class="wrap">
    <div class="sec-head"><p class="eyebrow">Pricing</p><h2>Free to try. Two ways to subscribe.</h2></div>
    <div class="plans">
      <div class="card"><p class="eyebrow">Weekly</p><p class="amt"><span class="num">$4.99</span> / week</p><p>Try it for a week and stop whenever you like.</p></div>
      <div class="card best"><p class="eyebrow">Yearly</p><p class="amt"><span class="num">$49.99</span> / year</p><p>About $0.96 a week. Best for a full 14-day snapshot cycle, and beyond.</p></div>
    </div>
    <p class="disclaimer">Billed by Apple through your App Store account. Cancel anytime in Settings.</p>
  </div></section>

  <section class="sec"><div class="wrap narrow"><div class="sec-head"><p class="eyebrow">FAQ</p><h2>Before you download.</h2></div><Accordion items={faq} /></div></section>

  <section class="sec"><div class="wrap"><div class="cta panel"><h2>Start with a free, private scan.</h2><p>Then take the plan with you.</p><AppBadge ct="app-page-final" primary /></div></div></section>
</Base>
<style>
  .hero { position: relative; padding: 36px 0 32px; overflow: hidden; }
  .glow { position: absolute; inset: -120px 0 auto; height: 780px; background: radial-gradient(40% 55% at 72% 42%, #3a2214, transparent); pointer-events: none; }
  .hg { position: relative; display: grid; gap: 24px; grid-template-columns: minmax(0, 1fr); align-items: center; }
  h1 span { display: block; color: var(--pill); }
  .acts { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin: 32px 0 18px; }
  .price { color: var(--lead); font-size: .95rem; } .price strong { color: #fff; }
  .ph { display: flex; justify-content: center; max-height: 360px; overflow: hidden; }
  .bento { display: grid; gap: 20px; grid-template-columns: 1fr; }
  .cell p { margin: 0; font-size: 1rem; }
  .ic { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; border-radius: 12px; background: rgba(243, 234, 219, .08); color: var(--pill); margin-bottom: 20px; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 20px; grid-template-columns: 1fr; }
  .shots { display: flex; justify-content: center; gap: 20px; margin-top: 56px; max-height: 420px; overflow: hidden; }
  .shots > :global(figure:nth-child(n+2)) { display: none; }
  .plans { display: grid; gap: 20px; grid-template-columns: 1fr; margin-bottom: 20px; }
  .amt { color: #fff; font-size: 1.1rem; margin: 0 0 6px; } .amt .num { font-size: 2.6rem; }
  .best { border-color: var(--eyebrow); background: linear-gradient(180deg, #2d2217, #1b140e); }
  .plans p:last-child { margin: 0; }
  .narrow { max-width: 780px; }
  .cta { text-align: center; padding: 64px 24px; background: var(--pill); border-color: transparent; box-shadow: 0 32px 64px -32px rgba(0, 0, 0, .8); }
  .cta :global(h2) { color: var(--ink); }
  .cta p { color: var(--ink-soft); font-size: 1.0625rem; }
  .cta :global(:focus-visible) { outline-color: var(--ink); }
  @media (min-width: 640px) { .steps { grid-template-columns: repeat(2, 1fr); } .plans { grid-template-columns: repeat(2, 1fr); } .shots > :global(figure:nth-child(n+2)) { display: block; } }
  @media (min-width: 900px) {
    .hero { padding: 80px 0 56px; } .hg { grid-template-columns: 1.2fr 1fr; gap: 80px; } .cta { padding: 96px 40px; } .ph { max-height: none; overflow: visible; }
    .bento { grid-template-columns: repeat(6, 1fr); } .cell { grid-column: span 2; } .cell.wide { grid-column: span 3; }
    .steps { grid-template-columns: repeat(4, 1fr); }
  }
</style>
