---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import GuideCard from '../../components/GuideCard.astro';
import GuideTabs from '../../components/GuideTabs.astro';
import Accordion from '../../components/Accordion.astro';
import PhoneFrame from '../../components/PhoneFrame.astro';
import Portrait from '../../components/Portrait.astro';
import { faceFor } from '../../data/faces';
import Icon from '../../components/Icon.astro';
import Byline from '../../components/Byline.astro';
import { personLd } from '../../data/authors';
import { render } from 'astro:content';
import { getPosts, clusterOf, related } from '../../lib/posts';
import { CLUSTERS, SITE, appStoreLink } from '../../lib/site';
import { TOOLS } from '../../data/tools';

export async function getStaticPaths() {
  const posts = await getPosts();
  const clusterPaths = Object.values(CLUSTERS)
    .filter((c) => posts.some((p) => CLUSTERS[p.data.cluster].slug === c.slug))
    .map((c) => ({ params: { slug: c.slug }, props: { kind: 'cluster' as const, cluster: c, posts: posts.filter((p) => CLUSTERS[p.data.cluster].slug === c.slug), all: posts } }));
  const postPaths = posts.map((p) => ({ params: { slug: p.data.slug }, props: { kind: 'post' as const, post: p, all: posts } }));
  const clash = clusterPaths.find((c) => postPaths.some((p) => p.params.slug === c.params.slug));
  if (clash) throw new Error(`Post slug collides with cluster hub: ${clash.params.slug}`);
  return [...clusterPaths, ...postPaths];
}
const props = Astro.props as any;
const MODULE_CTA: Record<string, string> = { skin: 'Your skin plan', hair: 'Your hair plan', jawline: 'Your jawline plan', posture: 'Your posture plan', smile: 'Your smile plan', general: 'Your full plan' };
const MODULE_PHONE: Record<string, [string, string]> = {
  skin: ['/app/traits.webp', 'Axend app trait scores including skin'], hair: ['/app/traits.webp', 'Axend app trait scores including hair'],
  jawline: ['/app/plan.webp', 'Axend app daily jawline workout'], posture: ['/app/plan.webp', 'Axend app daily workout plan'],
  smile: ['/app/traits.webp', 'Axend app trait scores including smile'], general: ['/app/traits.webp', 'Axend app overall score and traits'],
};
const fmt = (x: Date) => x.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
{props.kind === 'cluster' ? (
  <Base title={`${props.cluster.label}: Guides | Axend`} description={props.cluster.blurb} path={`/guides/${props.cluster.slug}`}>
    <PageHero eyebrow="Guides" title={props.cluster.label} lead={props.cluster.blurb} portrait={faceFor(props.cluster.slug)} />
    <div class="wrap">
      <GuideTabs posts={props.all} current={props.cluster.slug} />
      <div class="grid">{props.posts.map((p: any) => <GuideCard post={p} />)}</div>
    </div>
  </Base>
) : await (async () => {
  const post = props.post;
  const { Content } = await render(post);
  const d = post.data;
  const tool = TOOLS.find((t) => t.path === d.tool)!;
  const rel = related(post, props.all, 3);
  const url = new URL(`/guides/${d.slug}`, SITE.url).href;
  const mins = Math.max(3, Math.round((post.body ?? '').split(/\s+/).length / 200));
  const [phoneSrc, phoneAlt] = MODULE_PHONE[d.module];
  const jsonLd: object[] = [
    { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description, datePublished: d.publishDate.toISOString(), dateModified: d.updatedDate.toISOString(), mainEntityOfPage: url, author: personLd(), publisher: { '@type': 'Organization', name: 'Axend', url: SITE.url, sameAs: [SITE.appStoreUrl] }, ...(d.sources?.length ? { citation: d.sources.map((s: any) => ({ '@type': 'CreativeWork', name: s.title, url: s.url, publisher: { '@type': 'Organization', name: s.publisher } })) } : {}) },
    { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Guides', item: new URL('/guides', SITE.url).href }, { '@type': 'ListItem', position: 2, name: d.title, item: url }] },
  ];
  if (d.itemList?.length) jsonLd.push({ '@context': 'https://schema.org', '@type': 'ItemList', name: d.title, itemListElement: d.itemList.map((it: any, i: number) => ({ '@type': 'ListItem', position: i + 1, name: it.name, url: it.url })) });
  if (d.faq?.length) jsonLd.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: d.faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
  return (
    <Base title={`${d.title} | Axend`} description={d.description} path={`/guides/${d.slug}`} type="article" jsonLd={jsonLd}>
      <PageHero eyebrow={clusterOf(post).label} title={d.title} meta={`${mins} min read · For adults 18+ · Cosmetic and self-care only`} portrait={faceFor(d.slug)} />
      <article class="wrap post">
        <Byline updated={fmt(d.updatedDate)} />
        <p class="trust">About this guide: written by the Axend founder to our <a href="/about">editorial standards</a>. Scores in the tool follow our published <a href="/how-we-score">method</a>.</p>
        <div class="prose"><Content /></div>
        {d.sources?.length ? <section class="sources"><h2>Sources</h2><ul>{d.sources.map((s: any) => <li><a href={s.url} rel="noopener nofollow" target="_blank">{s.title}</a> <span>{s.publisher}</span></li>)}</ul></section> : null}
        <aside class="mini panel">
          <div class="mf"><Portrait face={faceFor(d.slug, 1)} mode="guides" /></div>
          <div><p class="eyebrow">Free, private</p><h3>Where do you stand today?</h3><p>Take the {tool.nav.toLowerCase()}. It runs on your device and nothing is uploaded.</p><a class="btn" href={tool.path}>Try the {tool.nav}</a></div>
        </aside>
        {d.faq?.length ? <section class="faq"><h2>FAQ</h2><Accordion items={d.faq} /></section> : null}
        <aside class="app panel">
          <div><p class="eyebrow">Axend app</p><h3>{MODULE_CTA[d.module]}</h3><p>A step-by-step plan based on your own scan, in the Axend app.</p><a class="btn ghost" href={appStoreLink(`guide-${d.slug}`)} rel="noopener"><Icon name="plan" size={18} /> Get {MODULE_CTA[d.module].toLowerCase()} in Axend</a></div>
          <PhoneFrame src={phoneSrc} alt={phoneAlt} width={170} />
        </aside>
        <p class="disclaimer prose">This guide is general self-care information, not medical advice. See a doctor or dermatologist for medical concerns.</p>
      </article>
      <section class="sec"><div class="wrap">
        <div class="sec-head"><p class="eyebrow">Keep reading</p></div>
        <div class="grid">{rel.map((p) => <GuideCard post={p} />)}</div>
      </div></section>
    </Base>
  );
})()}
<style>
  .grid { display: grid; gap: 4px 32px; grid-template-columns: 1fr; padding-bottom: 56px; }
  .post { padding-bottom: 24px; }
  .post > * { max-width: 680px; }
  .trust { font-size: .9rem; color: var(--muted, inherit); margin: 0 0 28px; padding: 12px 16px; border: 1px solid var(--hair-soft); border-radius: 12px; }
  .trust a { text-decoration: underline; }
  .sources h2 { margin: 48px 0 14px; }
  .sources ul { padding-left: 1.2em; display: grid; gap: 8px; }
  .sources li span { opacity: .7; font-size: .9em; }
  .sources li span::before { content: '· '; }
  .post .faq h2 { margin: 56px 0 18px; }
  .mini { display: grid; gap: 18px; padding: 20px; margin: 40px 0; grid-template-columns: 1fr; align-items: center; }
  .mini h3, .app h3 { margin-bottom: 6px; } .mini p:not(.eyebrow), .app p:not(.eyebrow) { font-size: 1rem; }
  .mf { width: 120px; background: #0c0906; border: 1px solid var(--hair-soft); border-radius: 14px; overflow: hidden; }
  .app { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 24px 24px 0; margin: 48px 0 28px; overflow: hidden; }
  .app > div:first-child { padding-bottom: 24px; flex: 1; }
  @media (min-width: 560px) { .mini { grid-template-columns: 120px 1fr; } }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 559px) { .app { flex-direction: column; align-items: flex-start; padding-bottom: 0; } .app > div:first-child { padding-bottom: 0; } .app :global(.phone) { align-self: center; } }
</style>
